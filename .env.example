# SpendWise Configuration Example
# Copy to .env if you wish to override default local settings

# Local SQLite Database Path
SPENDWISE_DB_PATH=data/spendwise.db

# Tesseract OCR Executable (optional, defaults to searching PATH and Program Files)
# On Windows, typically: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_PATH=tesseract

# Local Ollama AI Settings (optional local LLM provider)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
